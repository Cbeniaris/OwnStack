/* HID mouse device. protocol-code "none" because the report format is custom (16-bit X/Y). */
&zephyr_udc0 {
    hid_dev_0: hid_dev_0 {
        compatible = "zephyr,hid-device";
        protocol-code = "none";
        in-report-size = <6>;
        in-polling-period-us = <1000>;
    };

    /* HID config interface (host command protocol): 32-byte input and output reports. */
    hid_dev_1: hid_dev_1 {
        compatible = "zephyr,hid-device";
        protocol-code = "none";
        in-report-size = <32>;
        in-polling-period-us = <1000>;
        out-report-size = <32>;
        out-polling-period-us = <1000>;
    };

    /* HID keyboard for key bindings and macros: 8-byte input report (modifiers, reserved, 6 keys). */
    hid_dev_2: hid_dev_2 {
        compatible = "zephyr,hid-device";
        protocol-code = "none";
        in-report-size = <8>;
        in-polling-period-us = <1000>;
    };
};
